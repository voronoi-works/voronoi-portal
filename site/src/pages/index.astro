---
import Island from '../components/Island';
import '../styles/globals.css';

const title = 'voronoi.works — 島のいま、島のあしあと';
const description = '小さな活動の集まる島。ghostで考え、buildでつくる。X・Threadsからnoteへ、InstagramからYouTubeへ。制作と発信の入口を、島からたどる。';
const publicBuild = process.env.VORONOI_PUBLIC === '1';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {publicBuild ? (
      <link rel="canonical" href="https://voronoi.works/" />
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {publicBuild && <script is:inline>
(() => {
  if (location.origin !== 'https://voronoi.works') return;
  window.dataLayer = window.dataLayer || [];
  function gtag() { window.dataLayer.push(arguments); }
  gtag('js', new Date());
  gtag('config', 'G-40BMVKNFS4', {
    allow_google_signals: false,
    allow_ad_personalization_signals: false
  });
  const script = document.createElement('script');
  script.async = true;
  script.src = 'https://www.googletagmanager.com/gtag/js?id=G-40BMVKNFS4';
  document.head.appendChild(script);
})();
</script>}
  </head>
  <body>
    <Island publicBuild={publicBuild} client:load />
    {publicBuild && <footer style="padding:0.75rem 1rem 1.5rem;text-align:center;font-size:0.8125rem"><a href="/privacy.html" style="color:inherit;text-decoration:underline;text-underline-offset:0.2em">プライバシー</a></footer>}
  </body>
</html>

